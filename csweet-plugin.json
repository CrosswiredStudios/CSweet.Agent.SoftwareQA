{
  "$schema": "https://raw.githubusercontent.com/CrosswiredStudios/CSweetAgentSdk/main/schemas/csweet-plugin.v2.schema.json",
  "manifestVersion": "2.0",
  "kind": "agent",
  "rolePolicy": {
    "profile": "independent-reviewer.v1",
    "declaredRoleKeys": [
      "software-qa"
    ],
    "specializationKeys": [
      "software-testing",
      "release-validation"
    ]
  },
  "id": "com.csweet.software-qa",
  "name": "Priya Shah",
  "version": "1.2.1",
  "publisher": {
    "id": "com.csweet",
    "name": "C-Sweet"
  },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/CSweet.Agents.SoftwareQA/CSweet.Agents.SoftwareQA.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "OnDemand",
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1,
    "environmentProfile": "software-development-polyglot-v1",
    "workspaceAccess": "ReadWrite"
  },
  "protocol": {
    "minimumVersion": "2.0",
    "maximumVersion": "2.x"
  },
  "provides": [
    {
      "name": "work.execution.run.v2",
      "description": "Execute the authoritative task or delivery-plan scope with exact revision evidence and independent QA.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "format": "uuid"
          },
          "stageExecutionId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "workstreamId": {
            "type": "string",
            "format": "uuid"
          },
          "boardId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationUserId": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "deliveryPlanId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "sprintId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "sprintExecutionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "agentInstallationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "policyRevisionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "scopeRevision": {
            "type": "integer",
            "minimum": 0
          },
          "assignmentRevision": {
            "type": "integer",
            "minimum": 0
          },
          "planningRevision": {
            "type": "integer",
            "minimum": 0
          },
          "traversal": {
            "type": "integer",
            "minimum": 0
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "identifier": {
            "type": "string"
          },
          "stageKey": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "enum": [
              "Task",
              "Story",
              "Epic",
              "Release"
            ]
          },
          "item": {
            "type": "object"
          },
          "input": {
            "type": "object"
          },
          "priorOutcomes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "permittedOutcomes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "executionId",
          "stageExecutionId",
          "attemptId",
          "organizationId",
          "workstreamId",
          "boardId",
          "scope",
          "scopeRevision",
          "organizationUserId",
          "assignmentRevision",
          "planningRevision",
          "stageKey",
          "attempt",
          "deadline",
          "instructions",
          "item",
          "input",
          "priorOutcomes",
          "evidence",
          "permittedOutcomes"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "stageExecutionId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "disposition": {
            "enum": [
              "Completed",
              "Blocked",
              "Failed"
            ]
          },
          "outcomeCode": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "output": {},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "stageExecutionId",
          "attemptId",
          "disposition",
          "outcomeCode",
          "summary",
          "output",
          "evidence",
          "diagnostics"
        ],
        "additionalProperties": false
      },
      "executionTimeoutSeconds": 3600,
      "idempotency": "work-item",
      "riskClass": "standard"
    },
    {
      "name": "work.execution.run.v1",
      "description": "Execute one pinned board QA stage and return a structured outcome without mutating the card transition.",
      "inputSchema": {
        "type": "object",
        "required": [
          "stageExecutionId",
          "attemptId",
          "boardId",
          "itemId",
          "stageKey",
          "priorOutcomes"
        ],
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "stageExecutionId",
          "attemptId",
          "disposition",
          "outcomeCode",
          "summary",
          "output",
          "evidence",
          "diagnostics"
        ],
        "additionalProperties": true
      },
      "executionTimeoutSeconds": 1800,
      "idempotency": "work-item",
      "riskClass": "elevated"
    },
    {
      "name": "software-quality.validate.v1",
      "description": "Validate an immutable software revision against approved acceptance criteria and return bounded evidence.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "objective",
          "requirements",
          "acceptanceCriteria"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "sourceCommitSha": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workId",
          "verdict",
          "report",
          "completedAt"
        ],
        "properties": {
          "workId": {
            "type": "string",
            "format": "uuid"
          },
          "verdict": {
            "type": "string"
          },
          "report": {
            "type": "string",
            "minLength": 1
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "executionTimeoutSeconds": 900,
      "idempotency": "work-item",
      "riskClass": "elevated"
    },
    {
      "name": "agent.configuration.describe.v1",
      "description": "Describe Software QA configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "none",
      "riskClass": "standard"
    },
    {
      "name": "agent.configuration.update.v1",
      "description": "Update Software QA configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "settings"
        ],
        "properties": {
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "llmProviderId": {
                "type": "string"
              },
              "llmModel": {
                "type": "string"
              },
              "maxContextWindowTokens": {
                "type": "number",
                "minimum": 16000
              },
              "maxOutputTokens": {
                "type": "number",
                "minimum": 1000
              },
              "maxQaReworkCycles": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "customInstructions": {
                "type": "string"
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "work-item",
      "riskClass": "standard"
    }
  ],
  "requires": [
    {
      "name": "work.delivery.read.v1",
      "scope": "organization",
      "purpose": "Read or manage explicitly authorized delivery scope and exact evidence within assigned role grants.",
      "modelVisible": false
    },
    {
      "name": "work.delivery.evidence.read.v1",
      "scope": "organization",
      "purpose": "Read or manage explicitly authorized delivery scope and exact evidence within assigned role grants.",
      "modelVisible": false
    },
    {
      "name": "platform.artifact.read.v1",
      "scope": "organization",
      "purpose": "Read or manage explicitly authorized delivery scope and exact evidence within assigned role grants.",
      "modelVisible": false
    },
    {
      "name": "work.item.create",
      "scope": "board",
      "purpose": "Create preview defect planning tickets only on an explicitly granted board."
    },
    {
      "name": "work.item.types.read.v1",
      "scope": "board",
      "purpose": "Choose an allowed planning ticket type on the assigned triage board."
    },
    {
      "name": "work.calendar.read.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.create.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.update.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.cancel.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.schedule.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.personal-todo.read.v1",
      "scope": "organization",
      "purpose": "Read resource-scoped personal queues"
    },
    {
      "name": "work.personal-todo.add.v1",
      "scope": "organization",
      "purpose": "Add self or direct-report personal work"
    },
    {
      "name": "work.personal-todo.reorder.v1",
      "scope": "organization",
      "purpose": "Reorder directly managed personal work"
    },
    {
      "name": "work.personal-todo.requeue.v1",
      "scope": "organization",
      "purpose": "Requeue blocked personal work"
    },
    {
      "name": "work.personal-todo.claim.v1",
      "scope": "organization",
      "purpose": "SDK-managed atomic personal work claims"
    },
    {
      "name": "work.personal-todo.complete.v1",
      "scope": "organization",
      "purpose": "SDK-managed personal work completion"
    },
    {
      "name": "work.personal-todo.block.v1",
      "scope": "organization",
      "purpose": "SDK-managed durable personal work blocking"
    },
    {
      "name": "work.personal-todo.release.v1",
      "scope": "organization",
      "purpose": "SDK-managed personal work release"
    },
    {
      "name": "platform.llm.chat-stream.v1",
      "scope": "organization",
      "purpose": "Run the bounded QA harness with an approved model"
    },
    {
      "name": "work.item.read",
      "scope": "work-item",
      "purpose": "Read only the assigned ticket and immutable quality brief"
    },
    {
      "name": "git.workspace.prepare.v2",
      "scope": "work-item",
      "purpose": "Prepare the Core-resolved exact source commit without credentials or Git metadata"
    },
    {
      "name": "git.workspace.inspect.v2",
      "scope": "work-item",
      "purpose": "Verify the tested revision and detect tracked source changes"
    },
    {
      "name": "git.workspace.cleanup.v2",
      "scope": "work-item",
      "purpose": "Remove completed QA workspaces or retain failures for bounded diagnostics"
    },
    {
      "name": "source-control.task-review.read.v1",
      "scope": "work-item",
      "purpose": "Participate in durable review of the exact task source revision"
    },
    {
      "name": "source-control.task-review.quality.v1",
      "scope": "work-item",
      "purpose": "Participate in durable review of the exact task source revision"
    },
    {
      "name": "git.workspace.sync.v1",
      "scope": "work-item",
      "purpose": "Materialize exact QA source and inspect tracked changes"
    },
    {
      "name": "source-control.task-review.list.v1",
      "scope": "work-item",
      "purpose": "Recover assigned pending reviews after a missed wake event"
    }
  ],
  "events": {
    "subscribes": [
      "com.csweet.calendar.reminder-due.v1",
      "com.csweet.work.personal-todo.available.v1",
      "com.csweet.communication.message.mentioned.v1",
      "com.csweet.source-control.task-review.requested.v1"
    ]
  },
  "configuration": [
    {
      "key": "llmProviderId",
      "type": "provider",
      "label": "LLM provider",
      "required": true,
      "secret": false
    },
    {
      "key": "llmModel",
      "type": "model",
      "label": "Model",
      "required": true,
      "secret": false
    },
    {
      "key": "maxContextWindowTokens",
      "type": "number",
      "label": "Maximum context-window tokens",
      "required": true,
      "secret": false,
      "defaultValue": 256000
    },
    {
      "key": "maxOutputTokens",
      "type": "number",
      "label": "Maximum output tokens",
      "required": true,
      "secret": false,
      "defaultValue": 128000
    },
    {
      "key": "maxQaReworkCycles",
      "type": "number",
      "label": "Maximum QA rework cycles",
      "required": true,
      "secret": false,
      "defaultValue": 3
    },
    {
      "key": "customInstructions",
      "type": "textarea",
      "label": "Custom instructions",
      "required": false,
      "secret": false
    }
  ],
  "credentials": [],
  "webAccess": {
    "mode": "Allowlist",
    "rules": [
      {
        "scheme": "https",
        "host": "api.nuget.org",
        "port": 443,
        "pathPrefix": "/",
        "methods": [
          "GET"
        ],
        "protocol": "http",
        "purpose": "Restore approved NuGet dependencies"
      },
      {
        "scheme": "https",
        "host": "registry.npmjs.org",
        "port": 443,
        "pathPrefix": "/",
        "methods": [
          "GET"
        ],
        "protocol": "http",
        "purpose": "Restore approved npm dependencies"
      },
      {
        "scheme": "https",
        "host": "pypi.org",
        "port": 443,
        "pathPrefix": "/",
        "methods": [
          "GET"
        ],
        "protocol": "http",
        "purpose": "Resolve approved Python dependencies"
      },
      {
        "scheme": "https",
        "host": "files.pythonhosted.org",
        "port": 443,
        "pathPrefix": "/",
        "methods": [
          "GET"
        ],
        "protocol": "http",
        "purpose": "Download approved Python dependencies"
      }
    ],
    "purpose": "Restore dependencies through the C-Sweet egress gateway"
  },
  "ui": [
    {
      "kind": "form",
      "id": "software-qa-settings",
      "title": "Software QA settings",
      "capability": "agent.configuration.update.v1"
    }
  ],
  "catalog": {
    "imageUrl": "https://raw.githubusercontent.com/CrosswiredStudios/CSweet.Agent.SoftwareQA/main/assets/branding/portrait-v1.jpg",
    "companyLogoUrl": "https://raw.githubusercontent.com/CrosswiredStudios/CSweet.Agent.SoftwareQA/main/assets/branding/csweet-icon.svg",
    "accentColor": "#397973",
    "summary": "Independently validates software revisions, reports reproducible defects, and supplies merge-gating evidence.",
    "category": "Engineering",
    "role": {
      "key": "software-qa",
      "name": "Software QA"
    },
    "license": {
      "spdxId": "LicenseRef-Proprietary"
    },
    "iconUrls": [],
    "roleAliases": [
      "Software QA",
      "Quality Engineer",
      "QA Engineer"
    ],
    "keywords": [
      "quality assurance",
      "testing",
      "release validation"
    ],
    "documentationUrl": "README.md"
  }
}
